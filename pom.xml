<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dansplugins</groupId>
    <artifactId>SimpleSkills</artifactId>
    <version>3.0.0-SNAPSHOT-8-8-2026</version>
    <packaging>jar</packaging>

    <name>SimpleSkills</name>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>

                <configuration>
                    <relocations>
                        <relocation>
                            <pattern>com.cryptomorin.xseries</pattern>
                            <!-- Be sure to change the package below -->
                            <shadedPattern>cryptomorin.xseries</shadedPattern>
                        </relocation>
                    </relocations>
                    <!--
                      Only the classes XMaterial needs are shaded. This list is the transitive
                      reference closure of com.cryptomorin.xseries.XMaterial in the pinned XSeries
                      version. Regenerate it when bumping XSeries: a class that is reachable from
                      XMaterial but filtered out here does not fail the build, it fails at runtime
                      as a NoClassDefFoundError on the server.

                      The filter is scoped to the XSeries artifact on purpose. An <includes> list
                      under <artifact>*:*</artifact> would also drop this plugin's own classes.
                    -->
                    <filters>
                        <filter>
                            <artifact>com.github.cryptomorin:XSeries</artifact>
                            <includes>
                                <include>com/cryptomorin/xseries/XMaterial*</include>
                                <include>com/cryptomorin/xseries/XAttribute*</include>
                                <include>com/cryptomorin/xseries/XBiome*</include>
                                <include>com/cryptomorin/xseries/XEnchantment*</include>
                                <include>com/cryptomorin/xseries/XEntityType*</include>
                                <include>com/cryptomorin/xseries/XItemFlag*</include>
                                <include>com/cryptomorin/xseries/XPotion*</include>
                                <include>com/cryptomorin/xseries/XSound*</include>
                                <include>com/cryptomorin/xseries/base/**</include>
                                <include>com/cryptomorin/xseries/particles/**</include>
                            </includes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.18.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.Dans-Plugins</groupId>
            <artifactId>Ponder</artifactId>
            <version>v0.14</version>
        </dependency>
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
            <version>13.7.1</version>
            <scope>compile</scope>
        </dependency>
        <!-- Test dependencies -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>3.12.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
